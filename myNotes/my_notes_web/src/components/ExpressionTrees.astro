---
interface Props {variant?:'associativity'|'distributivity'}
const {variant='associativity'}=Astro.props;
const distributive=variant==='distributivity';
const trees=distributive?[[['∧',110,22],['A',65,75],['∨',155,75],['B',130,128],['C',180,128]],[['∨',110,22],['∧',55,75],['∧',165,75],['A',30,128],['B',80,128],['A',140,128],['C',190,128]]]:[[['∨',110,22],['∨',65,75],['C',155,75],['A',40,128],['B',90,128]],[['∨',110,22],['A',65,75],['∨',155,75],['B',130,128],['C',180,128]]];
const paths=distributive?['M110 22 65 75M110 22 155 75M155 75 130 128M155 75 180 128','M110 22 55 75M110 22 165 75M55 75 30 128M55 75 80 128M165 75 140 128M165 75 190 128']:['M110 22 65 75M110 22 155 75M65 75 40 128M65 75 90 128','M110 22 65 75M110 22 155 75M155 75 130 128M155 75 180 128'];
---
<figure class="expression-trees"><div>{trees.map((nodes,i)=><><svg viewBox="0 0 220 160" role="img" aria-label={distributive?(i===0?'A ∧ (B ∨ C)':'(A ∧ B) ∨ (A ∧ C)'):(i===0?'(A ∨ B) ∨ C':'A ∨ (B ∨ C)')}><path d={paths[i]} fill="none" stroke="var(--axis)"/>{nodes.map(([label,x,y])=><g><circle cx={x} cy={y} r="14" fill="var(--bg)"/><text x={x} y={Number(y)+5} text-anchor="middle" fill={label==='A'?'var(--accent)':label==='B'?'var(--blue)':label==='C'?'var(--purple)':'var(--text)'}>{label}</text></g>)}</svg>{i===0&&<span aria-hidden="true">≡</span>}</>)}</div><figcaption>{distributive?'A ∧ (B ∨ C) ≡ (A ∧ B) ∨ (A ∧ C)':'(A ∨ B) ∨ C ≡ A ∨ (B ∨ C)'}</figcaption></figure>
