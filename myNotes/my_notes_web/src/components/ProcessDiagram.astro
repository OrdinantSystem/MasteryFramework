---
import {processes,type ProcessPreset} from '../lib/learning/diagrams';
interface Props {preset:ProcessPreset;id:string}
const {preset,id}=Astro.props,l=Astro.locals.locale||'en',data=processes[preset];
const edgePath=(edge:typeof data.edges[number])=>{const a=data.nodes.find(n=>n.id===edge.from)!,b=data.nodes.find(n=>n.id===edge.to)!;const points=edge.route??[];let start:[number,number],end:[number,number];if(points.length){start=[a.x+(points[0][0]>a.x+175?350:0),a.y+45];const last=points.at(-1)!;end=last[1]>b.y+90?[b.x+175,b.y+90]:[last[0]<b.x?b.x:b.x+350,b.y+45];}else if(a.x===b.x){start=[a.x+175,a.y+(b.y>a.y?90:0)];end=[b.x+175,b.y+(b.y>a.y?0:90)];}else{start=[a.x+(b.x>a.x?350:0),a.y+45];end=[b.x+(b.x>a.x?0:350),b.y+45];}return 'M'+[start,...points,end].map(p=>p.join(',')).join(' L');};
---
<figure class="process-figure"><div class="figure-label">{data.title[l]}</div><svg class="process-desktop" data-pagefind-ignore="all" viewBox={`0 0 940 ${data.height}`} role="img" aria-labelledby={`${id}-title ${id}-caption`}><title id={`${id}-title`}>{data.title[l]}</title><defs><marker id={`${id}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M1 1 7 4 1 7" fill="none" stroke="var(--axis)" stroke-width="1.5"/></marker></defs>{data.edges.map(edge=><g><path d={edgePath(edge)} fill="none" stroke="var(--axis)" stroke-width="1.5" marker-end={`url(#${id}-arrow)`}/>{edge.label&&(()=>{const a=data.nodes.find(n=>n.id===edge.from)!;return <text x={edge.route?880:a.x+187} y={edge.route?a.y-70:a.y+(data.nodes.find(n=>n.id===edge.to)!.y>a.y?115:-35)} fill="var(--secondary)" font-size="19">{edge.label[l]}</text>})()}</g>)}{data.nodes.map(n=><foreignObject x={n.x} y={n.y} width="350" height="90"><div class:list={['process-node',n.role||'plain',{decision:n.decision}]}><strong>{n.label[l]}</strong><small>{n.detail[l]}</small></div></foreignObject>)}</svg>
<ol class="process-mobile">{data.nodes.map((n,i)=><li><strong>{n.label[l]}</strong><p>{n.detail[l]}</p><ul>{data.edges.filter(e=>e.from===n.id&&(e.label||e.to!==data.nodes[i+1]?.id)).map(e=><li><span>{e.label?.[l]}</span> → {data.nodes.find(n=>n.id===e.to)!.label[l]}</li>)}</ul></li>)}</ol><figcaption id={`${id}-caption`}>{data.caption[l]}</figcaption></figure>
