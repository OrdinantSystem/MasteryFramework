---
const l=Astro.locals.locale||'en';
const copy={en:{title:'Relationships in a linearity map',rows:[['Linear map','preserves','Addition and scaling'],['Additivity','implies','f(0) = 0'],['f(0) = 0','does not imply','Linearity']],caption:'The arrows make different claims. The converse shown in the final row fails: f(x) = x² is a counterexample.'},de:{title:'Beziehungen im Linearitätsnetz',rows:[['Lineare Abbildung','erhält','Addition und Skalierung'],['Additivität','impliziert','f(0) = 0'],['f(0) = 0','impliziert nicht','Linearität']],caption:'Die Pfeile behaupten Unterschiedliches. Die Umkehrung scheitert: f(x) = x² ist ein Gegenbeispiel.'},es:{title:'Relaciones en un mapa de linealidad',rows:[['Aplicación lineal','conserva','Suma y escalado'],['Aditividad','implica','f(0) = 0'],['f(0) = 0','no implica','Linealidad']],caption:'Las flechas afirman cosas distintas. La dirección inversa falla: f(x) = x² es un contraejemplo.'}}[l];
---
<figure class="relation-map"><div class="figure-label">{copy.title}</div>{copy.rows.map(([from,label,to],i)=><div class:list={['relation-row',{boundary:i===2}]}><strong>{from}</strong><span>{label}<span aria-hidden="true"> {i===2?'↛':'→'}</span></span><strong>{to}</strong></div>)}<figcaption>{copy.caption}</figcaption></figure>
