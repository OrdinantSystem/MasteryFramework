---
import {strings,type Locale} from '../lib/i18n';
interface Props {order:number;locale?:Locale;visual?:string}
const {order,locale='en',visual}=Astro.props;
const t=strings(locale);
const visualLabels:Record<string,Record<Locale,string>>={"reasoning-patterns":{en:"One observed history, different possible continuations",de:"Eine beobachtete Vergangenheit, verschiedene mögliche Fortsetzungen"},"reasoning-proof":{en:"Complete pairs combine into complete pairs",de:"Vollständige Paare ergeben wieder vollständige Paare"},"reasoning-equality":{en:"One solution becomes two after squaring",de:"Aus einer Lösung werden durch Quadrieren zwei"},"reasoning-algebra":{en:"Groups of three chairs with two fixed extras",de:"Dreiergruppen von Stühlen und zwei feste zusätzliche"},"reasoning":{en:"One counter plus one counter makes two",de:"Ein Zählstein und ein Zählstein ergeben zwei"},"shear-inverse": {"en": "A shear and its inverse", "de": "Eine Kippung und ihre Umkehrung"}, "area": {"en": "Areas one, two, and zero", "de": "Flächen eins, zwei und null"}, "diagonal": {"en": "Independent diagonal coordinate scaling", "de": "Unabhängige Skalierung der Koordinaten"}, "signs": {"en": "Two negative diagonal signs", "de": "Zwei negative Diagonalvorzeichen"}, "words": {"en": "An ordered word of R and L factors", "de": "Ein geordnetes Wort aus R und L"}, "equivalence": {"en": "Shear-equivalent matrices share a determinant", "de": "Kippungsäquivalente Matrizen haben dieselbe Determinante"}, "negative-identity": {"en": "A half-turn changes both signs", "de": "Eine halbe Drehung wechselt beide Vorzeichen"}, "inverse-product": {"en": "Isolate the inverse from MAN equals identity", "de": "Aus MAN gleich Identität die Umkehrung isolieren"}, "sheet-recap": {"en": "Shears, determinants, and sign matrices connected", "de": "Kippungen, Determinanten und Vorzeichenmatrizen im Zusammenhang"}};
const learningVisual=['learning-cycle','bloom','concept-map','explanation','practice','retrieval','workflow','hints','feedback','evidence','tutor','records','experiment','transcript'].includes(visual??'');
const analysisVisual=visual?.startsWith('reasoning')||(visual&&!visualLabels[visual]);
const labels=[t.mapLinear,t.vectorAlt,t.matrixAlt,t.mapProduct,t.rankAlt,t.rotationAlt,t.shearAlt,t.recap];
---
<div class:list={['lesson-thumbnail',`thumbnail-${order}`]}>
<svg viewBox="0 0 220 130" role="img" aria-label={visual?(visualLabels[visual]?.[locale]??`${t.concept} ${order}`):labels[order-1]}>
  {!analysisVisual&&[1,2,5,6,7].includes(order)&&<g stroke="var(--grid)" stroke-width="1"><path d="M20 30H200M20 55H200M20 80H200M20 105H200M45 12V118M80 12V118M115 12V118M150 12V118M185 12V118"/></g>}
  {!analysisVisual&&order===1&&<><path d="M30 110H205M55 120V15" stroke="var(--axis)"/><path d="M45 117 154 20" fill="none" stroke="var(--accent)" stroke-width="3"/><path d="M27 101 126 14" fill="none" stroke="var(--coral)" stroke-width="3" stroke-dasharray="5 4"/><circle cx="55" cy="108" r="4" fill="var(--accent)"/><text x="155" y="34" fill="var(--accent)" font-size="12">2x</text><text x="126" y="15" fill="var(--coral)" font-size="11">2x + 3</text></>}
  {!analysisVisual&&order===2&&<><path d="M35 105H200M65 118V10" stroke="var(--axis)"/><path d="m65 105 72-30m-72 30 10-67m62 37-62-37m0 0 72-30m-10 67 10-67" stroke="var(--blue)" stroke-dasharray="3 4" fill="none"/><path d="m65 105 72-30" stroke="var(--accent)" stroke-width="3"/><path d="m65 105 10-67" stroke="var(--blue)" stroke-width="3"/><path d="m65 105 82-97" stroke="var(--purple)" stroke-width="3"/><circle cx="147" cy="8" r="4" fill="var(--purple)"/></>}
  {!analysisVisual&&order===3&&<><g fill="none" stroke="var(--axis)"><path d="M21 31h-6v65h6m41-65h6v65h-6M95 31h-5v65h5m44-65h5v65h-5M171 31h-5v65h5m36-65h5v65h-5"/></g><rect x="23" y="53" width="37" height="20" rx="3" fill="var(--tint)"/><rect x="121" y="35" width="16" height="56" rx="3" fill="var(--blue-tint)"/><rect x="185" y="53" width="17" height="20" rx="3" fill="var(--purple-tint)"/><g font-family="Georgia,serif" font-size="12" fill="var(--text)" text-anchor="middle"><text x="31" y="48">3</text><text x="51" y="48">2</text><text x="31" y="68" fill="var(--accent)">7</text><text x="51" y="68" fill="var(--accent)">−5</text><text x="31" y="88">−1</text><text x="51" y="88">11</text><text x="77" y="68">×</text><text x="102" y="48">1</text><text x="129" y="48" fill="var(--blue)">1</text><text x="102" y="68">3</text><text x="129" y="68" fill="var(--blue)">4</text><text x="154" y="68">=</text><text x="194" y="68" fill="var(--purple)">−13</text></g></>}
  {!analysisVisual&&order===4&&<><path d="M35 65H190" stroke="var(--line)" stroke-width="2"/>{[35,85,135,185].map((x,i)=><><circle cx={x} cy="65" r="17" fill="var(--panel)" stroke={i===1?'var(--blue)':i===2?'var(--accent)':'var(--coral)'}/><text x={x} y="70" text-anchor="middle" fill="var(--text)" font-size="12">{[3,2,3,2][i]}</text></>)}<g font-size="11" text-anchor="middle"><text x="60" y="38" fill="var(--blue)">B →</text><text x="110" y="38" fill="var(--accent)">A →</text><text x="160" y="38" fill="var(--coral)">C →</text><text x="110" y="109" fill="var(--purple)">CAB</text></g></>}
  {!analysisVisual&&order===5&&<><path d="M22 110H200M70 120V12" stroke="var(--axis)"/><path d="m40 123 90-117" stroke="var(--purple)" stroke-dasharray="4 4"/><path d="m70 84 25-33" stroke="var(--accent)" stroke-width="4"/><path d="m70 84 50-65" stroke="var(--blue)" stroke-width="2.5"/><circle cx="95" cy="51" r="4" fill="var(--accent)"/><circle cx="120" cy="19" r="4" fill="var(--blue)"/><text x="135" y="70" fill="var(--purple)" font-size="12">{locale==='de'?'Rang = 1':'rank = 1'}</text></>}
  {!analysisVisual&&order===6&&<><circle cx="110" cy="65" r="43" stroke="var(--axis)" stroke-dasharray="3 5" fill="none"/>{[[145,40],[85,30],[75,90],[135,100]].map(([x,y],i)=><><path d={`M110 65L${x} ${y}`} stroke={i===0?'var(--accent)':i===1?'var(--blue)':i===2?'var(--purple)':'var(--coral)'} stroke-width="2.5"/><circle cx={x} cy={y} r="3" fill="var(--text)"/></>)}<text x="172" y="70" fill="var(--accent)" font-size="12">J⁴ = I</text></>}
  {!analysisVisual&&order===7&&<><path d="M30 110H205M50 118V12" stroke="var(--axis)"/><path d="M50 105H120V35H50Z" fill="none" stroke="var(--muted)" stroke-dasharray="4 4"/><path d="M50 105H120L175 35H105Z" fill="var(--tint)" stroke="var(--accent)" stroke-width="2.5"/><path d="M50 35H104" stroke="var(--coral)" stroke-width="2"/><text x="157" y="20" fill="var(--coral)" font-size="12">+ty →</text></>}
  {!analysisVisual&&order===8&&<><path d="M110 30V63M110 63H43V90M110 63H177V90M110 63V90" stroke="var(--axis)"/><rect x="75" y="15" width="70" height="27" rx="4" fill="var(--tint)" stroke="var(--accent)"/><text x="110" y="34" text-anchor="middle" fill="var(--accent)" font-size="13">Ax</text>{[43,110,177].map((x,i)=><rect x={x-25} y="90" width="50" height="23" rx="4" fill={['var(--blue-tint)','var(--purple-tint)','var(--coral-tint)'][i]} stroke={['var(--blue)','var(--purple)','var(--coral)'][i]}/>)}</>}
  {visual==='reasoning-proof'&&<>{[38,72,148,182].map((x,i)=><g><rect x={x-13} y="21" width="26" height="55" rx="13" fill={i<2?'var(--tint)':'var(--coral-tint)'} stroke={i<2?'var(--accent)':'var(--coral)'}/><circle cx={x} cy="37" r="7" fill={i<2?'var(--accent)':'var(--coral)'}/><circle cx={x} cy="60" r="7" fill={i<2?'var(--accent)':'var(--coral)'}/></g>)}<text x="110" y="55" text-anchor="middle" font-size="22" fill="var(--text)">+</text><text x="110" y="112" text-anchor="middle" font-size="23" fill="var(--purple)">2(a + b)</text></>}
  {visual==='reasoning-patterns'&&<><text x="110" y="32" text-anchor="middle" font-size="18" fill="var(--text)">2, 4, 8, 16, 32</text><path d="M110 47V60L60 82M110 60 160 82" fill="none" stroke="var(--axis)" stroke-width="2"/><text x="60" y="110" text-anchor="middle" font-size="26" fill="var(--blue)">64</text><text x="160" y="110" text-anchor="middle" font-size="26" fill="var(--purple)">34</text></>}
  {visual==='reasoning-equality' &&<><text x="110" y="29" text-anchor="middle" font-size="20" fill="var(--text)">x = 2 ⇒ x² = 4</text><circle cx="40" cy="78" r="19" fill="var(--tint)" stroke="var(--accent)"/><path d="M70 78H115m-8-6 8 6-8 6" fill="none" stroke="var(--axis)"/><circle cx="145" cy="78" r="19" fill="var(--coral-tint)" stroke="var(--coral)"/><circle cx="190" cy="78" r="19" fill="var(--tint)" stroke="var(--accent)"/><g text-anchor="middle" font-size="17" fill="var(--text)"><text x="40" y="84">2</text><text x="145" y="84">−2</text><text x="190" y="84">2</text></g></>}
  {visual==='reasoning-algebra'&&<>{[20,72,124].map(x=><><rect x={x} y="32" width="35" height="32" rx="4" fill="var(--blue-tint)" stroke="var(--blue)" stroke-width="2"/>{[7,17,28].map(dx=><circle cx={x+dx} cy="74" r="3" fill="var(--blue)"/>)}</>)}<circle cx="182" cy="64" r="5" fill="var(--purple)"/><circle cx="200" cy="64" r="5" fill="var(--purple)"/><text x="110" y="113" text-anchor="middle" font-size="21" fill="var(--text)">3n + 2</text></>}
  {visual==='reasoning'&&<><circle cx="35" cy="62" r="17" fill="var(--accent)"/><text x="68" y="70" font-size="26" fill="var(--text)">+</text><circle cx="111" cy="62" r="17" fill="var(--blue)"/><text x="143" y="70" font-size="26" fill="var(--text)">=</text><circle cx="191" cy="43" r="14" fill="var(--accent)"/><circle cx="191" cy="79" r="14" fill="var(--blue)"/></>}
  {visual==='shear-inverse'&&<><path d="M28 100H85L108 35H51Z" fill="var(--tint)" stroke="var(--accent)" stroke-width="2"/><path d="M141 100H193V35H141Z" fill="none" stroke="var(--blue)" stroke-width="2"/><text x="113" y="73" fill="var(--purple)" font-size="18">↔</text></>}
  {visual==='area'&&<><path d="M25 100H65V60H25Z" fill="var(--tint)" stroke="var(--accent)" stroke-width="2"/><path d="M90 100H130V20H90Z" fill="var(--blue-tint)" stroke="var(--blue)" stroke-width="2"/><path d="M155 100H200" stroke="var(--purple)" stroke-width="3"/><g fill="var(--muted)" font-size="11"><text x="40" y="118">1</text><text x="105" y="118">2</text><text x="173" y="118">0</text></g></>}
  {(visual==='diagonal'||visual==='signs')&&<><path d="M52 22H42V108H52M168 22H178V108H168" fill="none" stroke="var(--axis)"/><g font-size="23" text-anchor="middle"><text x="82" y="51" fill="var(--accent)">−1</text><text x="136" y="51" fill="var(--muted)">0</text><text x="82" y="92" fill="var(--muted)">0</text><text x="136" y="92" fill="var(--blue)">{visual==='diagonal'?'2':'−1'}</text></g></>}
  {visual==='words'&&<>{[40,90,140].map((x,i)=><><rect x={x} y="43" width="33" height="33" rx="3" fill={i===1?'var(--blue-tint)':'var(--tint)'} stroke={i===1?'var(--blue)':'var(--accent)'}/><text x={x+16} y="65" text-anchor="middle" fill="var(--text)" font-size="16">{i===1?'L':'R'}</text></>)}<text x="110" y="110" text-anchor="middle" fill="var(--purple)" font-size="12">R · L · R</text></>}
  {visual==='equivalence'&&<><text x="30" y="75" fill="var(--accent)" font-size="32">A</text><path d="M80 61H145m-7-6 7 6-7 6M80 80H145m-58-6-7 6 7 6" fill="none" stroke="var(--axis)"/><text x="166" y="75" fill="var(--blue)" font-size="32">B</text><text x="110" y="110" text-anchor="middle" fill="var(--purple)" font-size="11">det A = det B</text></>}
  {visual==='negative-identity'&&<><path d="M110 65 160 35M110 65 60 95" stroke="var(--accent)" stroke-width="3"/><circle cx="110" cy="65" r="45" stroke="var(--purple)" fill="none" stroke-dasharray="4 5"/><text x="110" y="25" fill="var(--blue)" font-size="12" text-anchor="middle">180°</text><text x="110" y="124" fill="var(--purple)" font-size="12" text-anchor="middle">(HL)² = −I</text></>}
  {visual==='inverse-product'&&<><text x="110" y="45" text-anchor="middle" fill="var(--accent)" font-size="21">M A N = I</text><path d="M110 56V78" stroke="var(--axis)"/><text x="110" y="106" text-anchor="middle" fill="var(--purple)" font-size="21">A⁻¹ = N M</text></>}
  {visual==='sheet-recap'&&<><path d="M45 63H175" stroke="var(--axis)"/>{[45,110,175].map((x,i)=><><circle cx={x} cy="63" r="21" fill={['var(--tint)','var(--blue-tint)','var(--purple-tint)'][i]} stroke={['var(--accent)','var(--blue)','var(--purple)'][i]}/><text x={x} y="69" text-anchor="middle" fill="var(--text)" font-size="16">{['T','det','D'][i]}</text></>)}</>}
  {learningVisual&&<>
    {visual==='retrieval'?<><path d="M25 74H195" stroke="var(--axis)"/>{[30,60,100,150,193].map((x,i)=><><circle cx={x} cy="74" r="5" fill="var(--accent)"/><text x={x} y="52" text-anchor="middle" fill="var(--text)" font-size="12">{[0,1,3,7,21][i]}</text></>)}</>:
    visual==='practice'?<>{['A','B','C','B','A','C'].map((v,i)=><><rect x={21+i*30} y="49" width="25" height="32" rx="3" fill={v==='A'?'var(--blue-tint)':v==='B'?'var(--tint)':'var(--purple-tint)'} stroke={v==='A'?'var(--blue)':v==='B'?'var(--accent)':'var(--purple)'}/><text x={33+i*30} y="70" text-anchor="middle" fill="var(--text)" font-size="13">{v}</text></>)}</>:
    visual==='hints'||visual==='bloom'?<>{[0,1,2,3,4,5].map((i)=><rect x={30+i*26} y={92-i*12} width="18" height={18+i*12} rx="2" fill={i%2?'var(--blue-tint)':'var(--tint)'} stroke={i%2?'var(--blue)':'var(--accent)'}/>)}</>:
    visual==='transcript'||visual==='records'||visual==='tutor'?<><path d="M58 18H147L170 42V112H58ZM147 18V42H170M76 57H150M76 74H150M76 91H128" fill="none" stroke="var(--blue)" stroke-width="2"/><circle cx="168" cy="96" r="14" fill="var(--tint)" stroke="var(--accent)"/></>:
    <><path d="M60 45H160V90H60Z" fill="none" stroke="var(--axis)" stroke-width="2"/>{[[60,45],[160,45],[160,90],[60,90]].map(([x,y],i)=><rect x={x-23} y={y-13} width="46" height="26" rx="5" fill={i%2?'var(--blue-tint)':'var(--tint)'} stroke={i%2?'var(--blue)':'var(--accent)'}/>)}<path d="m115 39 8 6-8 6" fill="none" stroke="var(--accent)"/></>}
  </>}
  {analysisVisual&&!learningVisual&&!visual?.startsWith('reasoning')&&<>
 {visual==='number-sets'?<>{[0,1,2,3].map((n)=><rect x={20+n*19} y={12+n*18} width={180-n*36} height={106-n*23} rx="4" fill="none" stroke={['var(--purple)','var(--blue)','var(--coral)','var(--accent)'][n]}/>)}<text x="31" y="31" fill="var(--purple)">ℂ</text><text x="51" y="49" fill="var(--blue)">ℝ</text><text x="72" y="68" fill="var(--coral)">ℚ</text><text x="102" y="93" fill="var(--accent)">ℕ</text></>:
 visual==='quantifiers'?<><text x="45" y="64" fill="var(--accent)" font-size="35">∀</text><text x="145" y="64" fill="var(--blue)" font-size="35">∃</text><path d="M87 50H130m-7-5 7 5-7 5" fill="none" stroke="var(--axis)"/><text x="110" y="101" text-anchor="middle" fill="var(--purple)">¬∀x P(x) ≡ ∃x ¬P(x)</text></>:
 visual==='nand'?<><path d="M25 50H78M25 80H78M78 35h30a30 30 0 0 1 0 60H78Z" fill="none" stroke="var(--accent)" stroke-width="2"/><circle cx="145" cy="65" r="6" fill="none" stroke="var(--accent)"/><path d="M151 65H195" stroke="var(--blue)"/><text x="110" y="120" text-anchor="middle" fill="var(--purple)">¬(A ∧ B)</text></>:
 visual==='parity'||visual==='irrational'?<><text x="110" y="47" text-anchor="middle" fill="var(--accent)" font-size="25">{visual==='parity'?'n = 2k':'√2 = p/q ?'}</text><path d="M110 59V77" stroke="var(--axis)"/><text x="110" y="105" text-anchor="middle" fill="var(--purple)" font-size="20">{visual==='parity'?'n² = 2(2k²)':'2 | p ∧ 2 | q'}</text></>:
 visual==='complement'||visual==='de-morgan'?<><rect x="25" y="20" width="170" height="90" fill="var(--blue-tint)" stroke="var(--blue)"/><circle cx="91" cy="65" r="32" fill="var(--tint)" stroke="var(--accent)"/><text x="91" y="70" fill="var(--accent)" text-anchor="middle">A</text><text x="157" y="70" fill="var(--blue)">¬A</text></>:
 visual==='identity-laws'?<><text x="110" y="53" text-anchor="middle" fill="var(--accent)" font-size="21">A ∨ 0 = A</text><text x="110" y="95" text-anchor="middle" fill="var(--blue)" font-size="21">A ∧ A = A</text></>:
 <><path d="M110 30 60 85M110 30 160 85" fill="none" stroke="var(--axis)"/><circle cx="110" cy="30" r="19" fill="var(--tint)" stroke="var(--accent)"/><circle cx="60" cy="85" r="20" fill="var(--blue-tint)" stroke="var(--blue)"/><circle cx="160" cy="85" r="20" fill="var(--purple-tint)" stroke="var(--purple)"/><g fill="var(--text)" font-size="17" text-anchor="middle"><text x="110" y="36">{visual==='boolean-laws'?'∧':'⇒'}</text><text x="60" y="91">A</text><text x="160" y="91">B</text></g></>}
</>}
</svg>
</div>
