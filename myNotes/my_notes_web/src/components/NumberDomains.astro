---
import Math from './Math.astro';
import MathText from './MathText.astro';
const l=Astro.locals.locale||'en';
const copy={en:['Number sets','Non-real','Irrational','Here $\\mathbb{N}$ starts at 1. Zero belongs to $\\mathbb{Z}$, but not to $\\mathbb{N}$.'],de:['Zahlenmengen','Nicht reell','Irrational','Hier beginnt $\\mathbb{N}$ bei 1. Null gehört zu $\\mathbb{Z}$, aber nicht zu $\\mathbb{N}$.'],es:['Conjuntos numéricos','No real','Irracional','Aquí $\\mathbb{N}$ empieza en 1. El cero pertenece a $\\mathbb{Z}$, pero no a $\\mathbb{N}$.']}[l];
---
<figure class="number-domains"><div class="domain complex"><strong><Math tex={String.raw`\mathbb{C}`} /></strong><span>{copy[1]}: <Math tex={String.raw`2+3i`} /></span><div class="domain real"><strong><Math tex={String.raw`\mathbb{R}`} /></strong><span>{copy[2]}: <Math tex={String.raw`\sqrt{2},\pi`} /></span><div class="domain rational"><strong><Math tex={String.raw`\mathbb{Q}`} /></strong><span><Math tex={String.raw`\frac12,-\frac23`} /></span><div class="domain integer"><strong><Math tex={String.raw`\mathbb{Z}`} /></strong><span><Math tex={String.raw`0,-1,-2,\ldots`} /></span><div class="domain natural"><strong><Math tex={String.raw`\mathbb{N}`} /></strong><span><Math tex={String.raw`1,2,3,\ldots`} /></span></div></div></div></div></div><figcaption>{copy[0]} · <Math tex={String.raw`\mathbb{N}\subset\mathbb{Z}\subset\mathbb{Q}\subset\mathbb{R}\subset\mathbb{C}`} />. <MathText text={copy[3]} /></figcaption></figure>
