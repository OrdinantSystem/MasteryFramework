---
import Math from './Math.astro';
import {setCopy,type SetFigureKind} from '../lib/reasoning/set-copy';
import {counterSets,peopleSets,shoePairs,matching,additionInputs,finiteSets,addNaturals} from '../lib/reasoning/examples';
interface Props {kind:SetFigureKind}
const {kind}=Astro.props,c=setCopy[Astro.locals.locale||'en'];
const people=finiteSets(peopleSets.a,peopleSets.b),counters=finiteSets(counterSets.a,counterSets.b);
const equation=kind==='singleton'?String.raw`A=\{a\}`:kind==='singletons'?String.raw`A=\{a\},\qquad B=\{b\}`:kind==='union'?String.raw`A\cup B=\{${counters.union.join(',')}\}`:kind==='matching'?String.raw`|A|=|B|=${matching.from.length}`:kind==='overlap'?String.raw`|A\cup B|=${people.left.length}+${people.right.length}-${people.intersection.length}=${people.union.length}`:kind==='pairs'?String.raw`|P|=${shoePairs.length},\qquad |S|=${shoePairs.flat().length}`:'';
const height=kind==='union'?420:kind==='matching'?370:kind==='overlap'?365:kind==='pairs'?350:kind==='function'?330:250;
---
<figure class:list={['reasoning-figure','reasoning-set-figure',`reasoning-${kind}`]}>
 <svg viewBox={`0 0 640 ${height}`} role="img" aria-label={c[kind].description}>
  {kind==='objects'&&[160,480].map((x,i)=><>
   <circle cx={x} cy="95" r="55" fill={i===0?'var(--accent)':'var(--blue)'}/>
   <text x={x} y="111" text-anchor="middle" font-size="48" font-family="Georgia,serif" font-style="italic" fill="var(--bg)">{i===0?'a':'b'}</text>
   <text x={x} y="208" text-anchor="middle" font-size="28" fill="var(--text)">{i===0?c.first:c.second}</text>
  </>)}
  {(kind==='singleton'||kind==='singletons')&&(kind==='singleton'?[320]:[155,485]).map((x,i)=><>
   <circle cx={x} cy="125" r="112" fill={i===0?'var(--tint)':'var(--blue-tint)'} stroke={i===0?'var(--accent)':'var(--blue)'} stroke-width="3"/>
   <text x={x-65} y="67" font-size="32" fill={i===0?'var(--accent)':'var(--blue)'}>{i===0?'A':'B'}</text>
   <circle cx={x} cy="133" r="32" fill={i===0?'var(--accent)':'var(--blue)'}/>
   <text x={x} y="145" text-anchor="middle" font-size="36" font-family="Georgia,serif" font-style="italic" fill="var(--bg)">{i===0?'a':'b'}</text>
  </>)}
  {kind==='union'&&<>
   {[140,500].map((x,i)=><>
    <circle cx={x} cy="100" r="87" fill={i===0?'var(--tint)':'var(--blue-tint)'} stroke={i===0?'var(--accent)':'var(--blue)'} stroke-width="3"/>
    <text x={x-52} y="51" font-size="30" fill={i===0?'var(--accent)':'var(--blue)'}>{i===0?'A':'B'}</text>
    <circle cx={x} cy="105" r="27" fill={i===0?'var(--accent)':'var(--blue)'}/>
    <text x={x} y="116" text-anchor="middle" font-size="32" fill="var(--bg)">{i===0?'a':'b'}</text>
   </>)}
   <text x="320" y="119" text-anchor="middle" font-size="44" fill="var(--text)">∪</text>
   <path d="M140 198 250 253l-3-15m3 15-16-1M500 198 390 253l3-15m-3 15 16-1" fill="none" stroke="var(--axis)" stroke-width="3"/>
   <ellipse cx="320" cy="330" rx="190" ry="77" fill="var(--purple-tint)" stroke="var(--purple)" stroke-width="3"/>
   <text x="320" y="291" text-anchor="middle" font-size="29" fill="var(--purple)">A ∪ B</text>
   {[280,360].map((x,i)=><><circle cx={x} cy="340" r="27" fill={i===0?'var(--accent)':'var(--blue)'}/><text x={x} y="351" text-anchor="middle" font-size="32" fill="var(--bg)">{i===0?'a':'b'}</text></>)}
  </>}
  {kind==='matching'&&<>
   <rect x="30" y="12" width="180" height="345" rx="16" fill="var(--tint)" stroke="var(--accent)" stroke-width="3"/>
   <rect x="430" y="12" width="180" height="345" rx="16" fill="var(--blue-tint)" stroke="var(--blue)" stroke-width="3"/>
   <text x="120" y="57" text-anchor="middle" font-size="30" fill="var(--text)">{c.setA}</text><text x="520" y="57" text-anchor="middle" font-size="30" fill="var(--text)">{c.setB}</text>
   {matching.arrows.map(([a,b])=>{
    const y=110+a*90,target=110+b*90;
    return <><circle cx="120" cy={y} r="25" fill="var(--accent)"/><rect x="495" y={target-25} width="50" height="50" rx="5" fill="var(--blue)"/><path d={`M160 ${y} 478 ${target}l-12-8m12 8-12 8`} fill="none" stroke="var(--axis)" stroke-width="3"/></>;
   })}
  </>}
  {kind==='overlap'&&<>
   <circle cx="240" cy="185" r="155" fill="var(--tint)" fill-opacity="0.65" stroke="var(--accent)" stroke-width="3"/>
   <circle cx="400" cy="185" r="155" fill="var(--blue-tint)" fill-opacity="0.65" stroke="var(--blue)" stroke-width="3"/>
   <text x="135" y="70" font-size="34" fill="var(--accent)">A</text><text x="495" y="70" font-size="34" fill="var(--blue)">B</text>
   {people.union.map((name,i)=><><circle cx={150+i*170} cy="168" r="7" fill={name==='Sam'?'var(--purple)':name==='Alex'?'var(--accent)':'var(--blue)'}/><text x={150+i*170} y="211" text-anchor="middle" font-size="32" fill="var(--text)">{name}</text></>)}
  </>}
  {kind==='pairs'&&<>
   <rect x="18" y="8" width="604" height="334" rx="18" fill="var(--surface)" stroke="var(--axis)" stroke-width="3"/><text x="43" y="50" font-size="34" fill="var(--text)">P</text>
   {shoePairs.map((pair,i)=><>
    <rect x={45+i*285} y="73" width="265" height="240" rx="18" fill={i===0?'var(--tint)':'var(--blue-tint)'} stroke={i===0?'var(--accent)':'var(--blue)'} stroke-width="3"/>
    <text x={177+i*285} y="114" text-anchor="middle" font-size="28" fill="var(--text)">{i===0?c.firstPair:c.secondPair}</text>
    {pair.map((shoe,j)=>{const x=110+i*285+j*125;return <>
     <g transform={`translate(${x} 155) scale(${j===0?0.48:-0.48} 0.48)`}><path d="M-40 0H15V50L54 70Q71 79 61 96H-50Q-59 81-50 64Z" fill={i===0?'var(--accent)':'var(--blue)'}/><path d="M-49 80H61" stroke="var(--bg)" stroke-width="7"/></g>
     <text x={x} y="265" text-anchor="middle" font-size="30" fill="var(--text)">{shoe}</text>
    </>;})}
   </>)}
  </>}
  {kind==='function'&&<>
   <rect x="25" y="10" width="220" height="310" rx="15" fill="var(--tint)" stroke="var(--accent)" stroke-width="3"/>
   <rect x="395" y="10" width="220" height="310" rx="15" fill="var(--blue-tint)" stroke="var(--blue)" stroke-width="3"/>
   <text x="135" y="55" text-anchor="middle" font-size="28" fill="var(--text)">{c.input}</text><text x="505" y="55" text-anchor="middle" font-size="28" fill="var(--text)">{c.output}</text>
   {additionInputs.map(([a,b],i)=>{const y=113+i*80;return <>
    <text x="135" y={y} text-anchor="middle" font-size="36" fill="var(--text)">{`(${a}, ${b})`}</text><text x="505" y={y} text-anchor="middle" font-size="36" fill="var(--text)">{addNaturals(a,b)}</text>
    <path d={`M260 ${y-12}H380l-12-8m12 8-12 8`} fill="none" stroke="var(--axis)" stroke-width="3"/>
   </>;})}
  </>}
 </svg>
 {kind==='overlap'&&<p class="reasoning-result">{c.people.replace('{count}',String(people.union.length))}</p>}
 {equation&&<Math tex={equation} display/>}
 <figcaption>{c[kind].caption}</figcaption>
</figure>
