---
import InterleavingPractice from './InterleavingPractice.astro';
import {text} from '../lib/learning/diagrams';
interface Props {kind:'methods'|'mapping'|'interleaving'|'spacing'|'problem-first'|'hints'|'evidence'|'handoff'}
const {kind}=Astro.props,l=Astro.locals.locale||'en';
const t=(en:string,de:string,es:string)=>text(en,de,es)[l];
const methods=[
 [t('Mind mapping','Begriffsnetz','Mapa conceptual'),t('How does it fit together?','Wie hängt es zusammen?','¿Cómo se relaciona todo?'),t('Organize relationships','Beziehungen ordnen','Organizar relaciones'),'accent'],
 [t('Feynman explanation','Feynman-Erklärung','Explicación Feynman'),t('Can I explain why?','Kann ich das Warum erklären?','¿Puedo explicar por qué?'),t('Reconstruct understanding','Verständnis rekonstruieren','Reconstruir la comprensión'),'blue'],
 [t('Interleaved practice','Verschachteltes Üben','Práctica intercalada'),t('Which method fits here?','Welche Methode passt hier?','¿Qué método corresponde aquí?'),t('Discriminate and transfer','Unterscheiden und übertragen','Distinguir y transferir'),'purple'],
 [t('Spaced retrieval','Verteiltes Abrufen','Recuperación espaciada'),t('Can I use it later?','Kann ich es später nutzen?','¿Puedo usarlo más adelante?'),t('Maintain accessible knowledge','Wissen verfügbar halten','Mantener el conocimiento accesible'),'coral']
];
const hints=[t('Independent attempt','Selbstständiger Versuch','Intento autónomo'),t('Strategic question','Strategische Frage','Pregunta estratégica'),t('Relevant concept','Passender Begriff','Concepto pertinente'),t('One local step','Ein einzelner Schritt','Un paso concreto'),t('Analogous example','Analoges Beispiel','Ejemplo análogo'),t('Full solution','Vollständige Lösung','Solución completa')];
const dimensions=[t('Definitions','Definitionen','Definiciones'),t('Intuition','Intuition','Intuición'),t('Justification','Begründung','Justificación'),t('Boundaries','Geltungsgrenzen','Límites'),t('Transfer','Transfer','Transferencia'),t('Delayed recall','Späterer Abruf','Recuerdo diferido')];
---
<figure class:list={['learning-figure',`learning-${kind}`]}>
 {kind==='methods'&&<><div class="method-grid">{methods.map(([name,question,purpose,role],i)=><div class={`method-card ${role}`}><span class="figure-step">0{i+1}</span><h3>{name}</h3><p>{question}</p><small>{purpose}</small></div>)}</div><figcaption>{t('Four complementary jobs. Choose the method for the gap you are trying to close.','Vier ergänzende Aufgaben. Wähle die Methode passend zur konkreten Lücke.','Cuatro funciones complementarias. Elige el método según la laguna que quieras resolver.')}</figcaption></>}
 {kind==='mapping'&&<><div class="mapping-pair"><section><h3>{t('Related words','Verwandte Wörter','Palabras relacionadas')}</h3><div class="word-cloud">{[t('Study session','Lernsitzung','Sesión de estudio'),t('Mapping','Begriffsnetz','Mapas'),t('Retrieval','Abrufen','Recuperación'),t('Feedback','Rückmeldung','Retroalimentación'),t('Review','Wiederholen','Repaso')].map(label=><span>{label}</span>)}</div><p>{t('Which relationship does each connection claim?','Welche Beziehung behauptet jede Verbindung?','¿Qué relación afirma cada enlace?')}</p></section><section><h3>{t('A relationship you can explain','Eine erklärbare Beziehung','Una relación que puedes explicar')}</h3><div class="map-node">{t('Unaided explanation','Erklärung ohne Hilfe','Explicación sin ayuda')}</div><div class="map-edge">↓ {t('provides an attempt for','liefert einen Versuch für','aporta un intento para')}</div><div class="map-node blue">{t('Feedback','Rückmeldung','Retroalimentación')}</div><div class="map-edge">↓ {t('can identify','kann aufzeigen','puede identificar')}</div><svg class="map-fork" viewBox="0 0 400 30" aria-hidden="true"><path d="M200 0V8L100 28M200 8 300 28" fill="none" stroke="var(--accent)" stroke-width="2"/></svg><div class="map-branches"><div class="map-node">{t('Missing ideas','Fehlende Ideen','Ideas que faltan')}</div><div class="map-node">{t('Incorrect relationships','Falsche Beziehungen','Relaciones incorrectas')}</div></div></section></div><figcaption>{t('Illustrative study example: compare an unaided attempt with a reliable source to identify what needs correction.','Beispiel zum Lernen: Vergleiche einen Versuch ohne Hilfe mit einer verlässlichen Quelle, um Korrekturbedarf zu erkennen.','Ejemplo de estudio: compara un intento sin ayuda con una fuente fiable para identificar qué corregir.')}</figcaption></>}
 {kind==='interleaving'&&<InterleavingPractice />}
 {kind==='spacing'&&<><div class="figure-label">{t('Illustrative review schedule','Beispielhafter Wiederholungsplan','Calendario ilustrativo de repaso')}</div><ol class="review-timeline">{[0,1,3,7,21].map((day,i)=><li><strong>{t('Day','Tag','Día')} {day}</strong><span class="timeline-dot" aria-hidden="true"/><span>{i===0?t('Learn','Lernen','Aprender'):t('Retrieve','Abrufen','Recordar')}</span></li>)}</ol><figcaption>{t('Days are labels; spacing on this diagram is not to scale. These intervals are examples, not an optimal universal schedule. Adapt after success, difficulty, and deadlines.','Die Tageszahlen sind Beschriftungen; die Abstände sind nicht maßstabsgetreu. Die Intervalle sind Beispiele, kein universell optimaler Plan. An Erfolg, Schwierigkeiten und Termine anpassen.','Los días son etiquetas; las distancias no están a escala. Los intervalos son ejemplos, no un calendario universal óptimo. Adáptalos al resultado, la dificultad y los plazos.')}</figcaption></>}
 {kind==='problem-first'&&<><div class="progression-pair">{[[t('Knowledge-first route','Wissensorientierter Weg','Recorrido desde los conocimientos'),[t('Memorize facts','Fakten einprägen','Memorizar datos'),t('Understand concepts','Begriffe verstehen','Entender conceptos'),t('Apply later','Später anwenden','Aplicar después')]], [t('Goal-framed route','Zielorientierter Weg','Recorrido desde el objetivo'),[t('Preview a meaningful problem','Eine sinnvolle Aufgabe ansehen','Explorar un problema con sentido'),t('Identify missing foundations','Fehlende Grundlagen erkennen','Identificar las bases que faltan'),t('Learn, apply, and revisit','Lernen, anwenden und erneut prüfen','Aprender, aplicar y revisar')]]].map(([title,steps])=><section><h3>{title}</h3><ol>{(steps as string[]).map(step=><li>{step}</li>)}</ol></section>)}</div><figcaption>{t('The early problem supplies a purpose. It does not remove the need for instruction or worked examples.','Die frühe Aufgabe schafft einen Zweck. Erklärungen und ausgearbeitete Beispiele bleiben nötig.','El problema inicial aporta un propósito. Sigue haciendo falta instrucción y ejemplos resueltos.')}</figcaption></>}
 {kind==='hints'&&<><ol class="hint-ladder">{hints.map((label,i)=><li><strong>H{i}</strong><span>{label}</span></li>)}</ol><figcaption>{t('Record the highest hint used. Ask for the smallest next hint; a guided solution is evidence of assisted work.','Den höchsten genutzten Hinweis notieren. Den kleinsten nächsten Hinweis anfordern; eine geführte Lösung zeigt unterstützte Arbeit.','Registra la pista más alta utilizada. Pide la siguiente pista mínima; una solución guiada es evidencia de trabajo asistido.')}</figcaption></>}
 {kind==='evidence'&&<><div class="evidence-grid">{dimensions.map((v,i)=><div><span class="figure-step">0{i+1}</span><strong>{v}</strong><small>{t('A task + an observed result','Eine Aufgabe + ein beobachtetes Ergebnis','Una tarea + un resultado observado')}</small></div>)}</div><figcaption>{t('Keep a profile, not one mastery percentage. Not assessed means NA; immediate success is provisional.','Ein Profil führen, keinen einzigen Beherrschungsprozentsatz. Nicht geprüft heißt NA; unmittelbarer Erfolg ist vorläufig.','Conserva un perfil, no un porcentaje único de dominio. No evaluado significa NA; el éxito inmediato es provisional.')}</figcaption></>}
 {kind==='handoff'&&<><div class="handoff-strip">{[t('Sources + goal','Quellen + Ziel','Fuentes + objetivo'),t('Exact attempts + hints','Genaue Versuche + Hinweise','Intentos exactos + pistas'),t('Gaps + next task','Lücken + nächste Aufgabe','Lagunas + próxima tarea'),t('Delayed review','Spätere Wiederholung','Repaso diferido')].map(v=><span>{v}</span>)}</div><figcaption>{t('Carry the evidence into the next session. A new agent only knows the context you actually give it.','Die Nachweise in die nächste Sitzung mitnehmen. Ein neuer Agent kennt nur den tatsächlich mitgegebenen Kontext.','Lleva las evidencias a la siguiente sesión. Un agente nuevo solo conoce el contexto que realmente le das.')}</figcaption></>}
</figure>
