---
import MathText from '../MathText.astro';
import RotationExplorer from './RotationExplorer.astro';
import {graph} from '../../lib/geometry';
import {strings} from '../../lib/i18n';
import Math from '../Math.astro';
interface Props {kind:'rotation'|'shear';id?:string}
const {kind,id}=Astro.props,locale=Astro.locals.locale,t=strings(locale);
const title=t.shearTitle;
const formula=String.raw`A_t=\begin{pmatrix}1&t\\0&1\end{pmatrix},\quad (x,y)\mapsto(x+ty,y)`;
const label=t.shear;
---
{kind==='rotation' ? <RotationExplorer id={id}/> : <figure class="explorer" id={id}><div class="figure-heading"><span class="section-label">{t.try}</span><span class="live-dot">{t.interactive}</span></div><h3>{title}</h3>
<parameter-explorer data-kind={kind} data-locale={locale}><div class="graph" data-graph set:html={graph(kind,1,1,title)}/><div class="explorer-controls"><div class="sliders"><label>{label}<output data-a-output>1</output><input aria-label={label} data-a type="range" min="-2" max="2" step="0.5" value="1"/></label></div><p class="explorer-result" data-result aria-live="polite"><MathText text={`$t = 1$ · ${t.shearResult}`} /></p><button class="reset" data-reset type="button">{t.reset} ↺</button></div><div class="explorer-equation"><Math tex={formula} display/></div></parameter-explorer>
<figcaption>{t.shearCaption}</figcaption><noscript><p class="noscript-note">{t.noScript}</p></noscript></figure>}
<script>
import {renderMathText} from '../../lib/math-text';
import {graph} from '../../lib/geometry';
import {strings,type Locale} from '../../lib/i18n';
class ParameterExplorer extends HTMLElement {
 connectedCallback(){
  if(this.dataset.ready)return;this.dataset.ready="true";
  const kind=this.dataset.kind!,t=strings(this.dataset.locale as Locale),input=this.querySelector<HTMLInputElement>('[data-a]')!;
  const update=()=>{const n=Number(input.value);this.querySelector('[data-graph]')!.innerHTML=graph(kind,n,1,t.shearTitle);this.querySelector('[data-a-output]')!.textContent=String(n);this.querySelector('[data-result]')!.innerHTML=renderMathText(`$t = ${n}$ · ${t.shearResult}`)};
  input.addEventListener('input',update);this.querySelector('[data-reset]')!.addEventListener('click',()=>{input.value='1';update()});
 }
}
if(!customElements.get('parameter-explorer'))customElements.define('parameter-explorer',ParameterExplorer);
</script>
