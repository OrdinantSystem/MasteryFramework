---
/** Public MDX entry point. Presets are versioned with source, not copied into pages. */
import LogicLab from './LogicLab.astro';
import VectorLab from './VectorLab.astro';
import ParameterExplorer from './ParameterExplorer.astro';
import MatrixProduct from './MatrixProduct.astro';
import type {VectorPreset,VectorScenario} from '../../lib/interactive/vector-scenarios';
type Props =
 | {kind:'logic';preset?:'implication'|'nand';id:string}
 | {kind:'vectors';preset?:VectorPreset;scenario?:VectorScenario;id:string}
 | {kind:'rotation'|'shear';id?:string}
 | {kind:'matrix-product';left?:number[][];right?:number[][];title?:string;description?:string;caption?:string;id?:string};
const props=Astro.props;
---
{props.kind==='logic'?<LogicLab {...props}/>:props.kind==='vectors'?<VectorLab preset={props.preset} scenario={props.scenario} id={props.id}/>:props.kind==='matrix-product'?<MatrixProduct {...props}/>:<ParameterExplorer kind={props.kind} id={props.id}/>}
