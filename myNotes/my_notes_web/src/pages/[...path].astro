---
import {render,getEntry} from 'astro:content';
import AnalysisCompatibility from '../components/AnalysisCompatibility.astro';
import AnalysisCourseIntroduction from '../components/AnalysisCourseIntroduction.astro';
import analysisOrganization from '../lib/analysis-organization.json';
import {analysisAliases,canonicalAnalysisKeys} from '../lib/analysis-compatibility';
import AreaIcon from '../components/AreaIcon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ConceptMap from '../components/ConceptMap.astro';
import Thumbnail from '../components/Thumbnail.astro';
import {areas,courses,chaptersFor,courseFor,type CourseId} from '../lib/navigation';
import {learningComponents} from '../components/mdx';
import {getLessons,courseUrl,lessonUrl,url} from '../lib/content';
import {locales,strings,type Locale} from '../lib/i18n';
export async function getStaticPaths(){
 const paths=[];
 for(const locale of locales){
  const prefix=locale==='en'?'':`${locale}/`,all=await getLessons(locale);
  paths.push({params:{path:prefix||undefined},props:{locale,kind:'archive',lessons:all}});
  paths.push({params:{path:`${prefix}search`},props:{locale,kind:'search',lessons:all}});
  for(const course of courses){
   const lessons=all.filter(l=>l.data.course===course.id);
   paths.push({params:{path:`${prefix}${course.id}`},props:{locale,kind:'course',courseId:course.id,lessons}});
   for(const lesson of lessons)paths.push({params:{path:`${prefix}${course.id==='linear-algebra'?'':course.id+'/'}lessons/${lesson.key}`},props:{locale,kind:'lesson',courseId:course.id,lesson,lessons}});
  }
  for(const [oldKey,alias] of Object.entries(analysisAliases[locale]))if(!canonicalAnalysisKeys.has(oldKey))paths.push({params:{path:`${prefix}analysis/lessons/${oldKey}`},props:{locale,kind:'alias',courseId:'analysis',alias,oldKey,lessons:all.filter(l=>l.data.course==='analysis')}});
 }
 return paths;
}
const {locale,kind,lesson,lessons,courseId,alias,oldKey}=Astro.props;
Astro.locals.locale=locale as Locale;
const t=strings(locale),course=courseId?courseFor(courseId as CourseId):undefined;
const rendered=lesson?await render(lesson):undefined,Content=rendered?.Content;
const guide=kind==='course'&&courseId==='analysis'?await getEntry('courseGuides',`${locale}/analysis`):undefined;
const guideRendered=guide?await render(guide):undefined,Guide=guideRendered?.Content;
const title=lesson?.data.title||alias?.title||(kind==='search'?t.search:course?.title[locale]||'myNotes');
const countLessons=(count:number)=>`${count} ${count===1?t.countOne:t.count}`;
const description=lesson?.data.description||(kind==='search'?t.searchLead:course?.description[locale]||t.archiveLead);
const i=lessons.findIndex(l=>l.key===lesson?.key),previous=lessons[i-1],next=lessons[i+1];
---
<SiteLayout title={title} description={description} locale={locale} courseId={courseId as CourseId|undefined} current={lesson?.key||oldKey||(kind==='archive'?'index':kind)} headings={rendered?.headings||[]}>
 {kind==='archive'&&<>
  <h1 class="visually-hidden">myNotes</h1>
  {areas.filter(area=>courses.some(c=>c.area===area.id)).map(area=><section class="chapter-index" aria-labelledby={area.id}><h2 class="area-heading" id={area.id}><AreaIcon kind={area.icon}/>{area.title[locale]}</h2><ol class="lesson-list course-list">{courses.filter(c=>c.area===area.id).map(course=><li><div class="course-entry"><a class="course-main" href={courseUrl(course.id,locale)}><Thumbnail order={course.id==='linear-algebra'?2:0} visual={course.id==='analysis'?'logic':course.id==='learning'?'learning-cycle':course.id==='reasoning'?'reasoning':undefined} locale={locale}/><div><h3>{course.title[locale]}</h3><small>{countLessons(lessons.filter(l=>l.data.course===course.id).length)}</small></div><span class="index-arrow" aria-hidden="true">↗</span></a><nav class="course-chapter-links" aria-label={course.title[locale]}>{course.id==='analysis'&&analysisOrganization.legacyChapterAnchors.map(anchor=><span id={anchor.id}/>)}{chaptersFor(course.id).map(c=><a id={c.id} href={`${courseUrl(course.id,locale)}#${c.id}`}>{c.title[locale]}</a>)}</nav></div></li>)}</ol></section>)}
 </>}
 {kind==='course'&&course&&<>
  <header class="index-heading"><h1>{course.title[locale]}</h1></header>
  {course.id==='analysis'&&<AnalysisCourseIntroduction locale={locale as Locale}/>}
  <nav class="chapter-jumps" aria-label={t.contents}>{chaptersFor(course.id).map(c=><a href={`#${c.id}`}>{c.title[locale]}</a>)}</nav>
  {chaptersFor(course.id).map(chapter=><section class="chapter-index" aria-labelledby={chapter.id}>{course.id==='analysis'&&analysisOrganization.legacyChapterAnchors.filter(anchor=>anchor.module===chapter.id).map(anchor=><span id={anchor.id}/>)}<h2 id={chapter.id}>{chapter.title[locale]}<span class="index-total">{countLessons(lessons.filter(l=>l.data.chapter===chapter.id).length)}</span></h2>{chapter.id==='sheet-1-1'&&<ConceptMap locale={locale}/>}<ol class="lesson-list">{lessons.filter(l=>l.data.chapter===chapter.id).map(l=><li><a href={lessonUrl(l.key,locale,course.id)}><span class="index-number">{String(l.data.order).padStart(2,'0')}</span><Thumbnail order={l.data.order} visual={l.data.thumbnail} locale={locale}/><div><h3>{l.data.title}</h3></div><span class="index-arrow" aria-hidden="true">↗</span></a></li>)}</ol></section>)}
  {Guide&&guide&&<section class="prose course-review" data-analysis data-pagefind-body aria-labelledby="analysis-review">{analysisOrganization.legacyChapterAnchors.filter(anchor=>anchor.module==='analysis-review').map(anchor=><span id={anchor.id}/>)}<h2 id="analysis-review">{guide.data.title}</h2><Guide components={learningComponents}/><AnalysisCompatibility alias={analysisAliases[locale as Locale]['analysis-grundlagen-ueberblick']} locale={locale as Locale}/></section>}
 </>}
 {kind==='lesson'&&lesson&&Content&&course&&<>
  <article data-analysis={course.id==='analysis'?'':undefined} data-pagefind-body data-pagefind-filter={`${t.courses}:${course.title[locale]}`}>
   <header class="article-header"><h1 data-pagefind-meta="title">{lesson.data.title}</h1></header>
   {lesson.data.prerequisites.length>0&&<div class="prerequisites" data-pagefind-ignore><span>{t.prerequisites}</span>{lesson.data.prerequisites.map(id=><a href={lessonUrl(id,locale,course.id)}>{lessons.find(l=>l.key===id)?.data.navTitle}</a>)}</div>}
   <div class="prose"><Content components={learningComponents}/></div>
   {course.id==='analysis'&&<AnalysisCompatibility alias={analysisAliases[locale as Locale][lesson.key]} locale={locale as Locale}/>}
  </article>
  <nav class="page-turn" aria-label={t.lessons} data-pagefind-ignore><a href={previous?lessonUrl(previous.key,locale,course.id):courseUrl(course.id,locale)}><small>← {previous?t.previous:t.backOverview}</small><span>{previous?.data.navTitle||course.title[locale]}</span></a>{next&&<a class="next" href={lessonUrl(next.key,locale,course.id)}><small>{courseId==='analysis'&&next.data.order===18?t.optionalNext:t.next} →</small><span>{next.data.navTitle}</span></a>}</nav>
 </>}
 {kind==='alias'&&alias&&<>
  <Fragment slot="head"><meta name="robots" content="noindex,follow"/><link rel="canonical" href={new URL((alias.key?lessonUrl(alias.key,locale,'analysis'):courseUrl('analysis',locale))+'#'+alias.anchor,Astro.site)}/></Fragment>
  <article data-pagefind-ignore><h1>{alias.title}</h1><p>{t.relocated}</p><p><a href={(alias.key?lessonUrl(alias.key,locale,'analysis'):courseUrl('analysis',locale))+'#'+alias.anchor}>{t.continueLesson}</a></p></article>
  <AnalysisCompatibility alias={alias} locale={locale as Locale} redirect/>
 </>}
 {kind==='search'&&<>
  <header class="article-header"><h1>{t.search}</h1></header>
  <link rel="stylesheet" href={url('pagefind/pagefind-ui.css')}/><div id="search"></div><noscript><p>{t.noSearchScript}</p></noscript>
  <script is:inline src={url('pagefind/pagefind-ui.js')}></script>
  <script is:inline define:vars={{baseUrl:url(),t}}>
   if(window.PagefindUI){const ui=new PagefindUI({element:'#search',baseUrl,bundlePath:baseUrl+'pagefind/',showSubResults:true,showImages:false,translations:{placeholder:t.searchPlaceholder,zero_results:t.searchEmpty,searching:t.searching,clear_search:t.clear,many_results:t.many,one_result:t.one}});const q=new URL(location.href).searchParams.get('q');if(q)ui.triggerSearch(q);document.querySelector('#search').addEventListener('input',e=>{if(e.target.tagName==='INPUT'){const u=new URL(location.href);const q=e.target.value;if(q)u.searchParams.set('q',q);else u.searchParams.delete('q');history.replaceState(null,'',u)}})}else document.getElementById('search').textContent=t.noSearch;
  </script>
 </>}
</SiteLayout>
