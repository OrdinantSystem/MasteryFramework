---
import {patternFigureKinds} from '../lib/interactive/patterns-model';
import {proofFigureKinds} from '../lib/interactive/parity-model';
import {equationPresetNames} from '../lib/interactive/equation-model';
import {algebraFigureKinds} from '../lib/interactive/algebra-model';
import {teachingMap} from '../lib/learning/mind-map-presets';
import NumberDomains from '../components/NumberDomains.astro';
import ExpressionTrees from '../components/ExpressionTrees.astro';
import ProcessDiagram from '../components/ProcessDiagram.astro';
import LearningFigure from '../components/LearningFigure.astro';
import QuestionLens from '../components/QuestionLens.astro';
import StudyTemplate from '../components/StudyTemplate.astro';
import RelationMap from '../components/RelationMap.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import MatrixComparison from '../components/MatrixComparison.astro';
import Interactive from '../components/interactive/Interactive.astro';
import VectorFigure from '../components/VectorFigure.astro';
import {assets} from '../lib/interactive/catalog';
import ReasoningFigure from '../components/ReasoningFigure.astro';
import AnalysisProof from '../components/AnalysisProof.astro';
Astro.locals.locale='en';
---
<SiteLayout title="Representation library" description="Reusable teaching assets and authoring examples." locale="en" current="library">
  <meta slot="head" name="robots" content="noindex"/>
  <header class="article-header"><span class="section-label">AUTHORING REFERENCE</span><h1>Representation library</h1></header>
  <div class="prose">
    <p>This English authoring reference is outside lesson search and the learner navigation. The examples below are working components. Use the same snippets inside MDX lessons, with localized prose and a unique id for each vector activity.</p>
    <ul>{assets.map(asset=><li><a href={`#${asset.id}`}>{asset.name}</a> — {asset.purpose}</li>)}</ul>
    {assets.map(asset=><section id={asset.id}>
      <h2>{asset.name}</h2><p>{asset.purpose}</p><pre><code>{asset.example}</code></pre>
      {asset.id==='pattern-explorers'&&(['continuations','next-test'] as const).map(preset=><Interactive kind="patterns" preset={preset} id={`library-pattern-${preset}`}/>)}
      {asset.id==='pattern-figures'&&patternFigureKinds.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='proof-pairs'&&<Interactive kind="parity" preset="even-sum" id="library-complete-pairs"/>}
      {asset.id==='proof-figures'&&proofFigureKinds.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='equation-transformations' &&equationPresetNames.map(preset=><Interactive kind="equations" preset={preset} id={`library-equation-${preset}`}/>)}
    {asset.id==='equation-solutions'&&<ReasoningFigure kind="squared-solutions"/>}
    {asset.id==='algebra-models'&&(['tables','grouping'] as const).map(preset=><Interactive kind="algebra" preset={preset} id={`library-algebra-${preset}`}/>)}
      {asset.id==='algebra-figures'&&algebraFigureKinds.map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='reasoning-comparisons'&&(['appearance','units','water'] as const).map(preset=><Interactive kind="reasoning" preset={preset} id={`library-reasoning-${preset}`}/>)}
      {asset.id==='reasoning-figures'&&(['opening','collections','objects','singleton','singletons','matching','addition','overlap','pairs','function','symbols','process'] as const).map(kind=><ReasoningFigure kind={kind}/>)}
      {asset.id==='analysis-candidates'&&['equation','positive','witnesses'].map((preset)=><Interactive kind="candidates" preset={preset as 'equation'|'positive'|'witnesses'} id={`library-candidates-${preset}`}/>)}
      {asset.id==='analysis-conditions'&&['connectives','construction','demorgan'].map((preset)=><Interactive kind="conditions" preset={preset as 'connectives'|'construction'|'demorgan'} id={`library-conditions-${preset}`}/>)}
      {asset.id==='analysis-number-line'&&['bounds','complement','counterexample','distance'].map((preset)=><Interactive kind="number-line" preset={preset as 'bounds'|'complement'|'counterexample'|'distance'} id={`library-line-${preset}`}/>)}
      {asset.id==='analysis-quantifiers'&&<Interactive kind="quantifiers" preset="keys" id="library-keys"/>}
      {asset.id==='analysis-quantifiers'&&<Interactive kind="quantifiers" preset="keys" presentation="witnesses" id="library-keys-focused"/>}
      {asset.id==='analysis-quantifiers'&&<Interactive kind="quantifiers" preset="nested" id="library-nested"/>}
      {asset.id==='analysis-sequence'&&<Interactive kind="sequence" preset="reciprocal" id="library-tail"/>}
      {asset.id==='analysis-candidates'&&<Interactive kind="candidates" preset="equation" presentation="input" id="library-input-focused"/>}
      {asset.id==='analysis-sequence'&&<Interactive kind="sequence" preset="device" presentation="terms" id="library-terms-focused"/>}
      {asset.id==='analysis-sequence'&&<Interactive kind="sequence" preset="reciprocal" presentation="tail" id="library-tail-focused"/>}
      {asset.id==='analysis-proof'&&['equivalence','scope','contradiction','complement'].map(preset=><AnalysisProof preset={preset as 'equivalence'|'scope'|'contradiction'|'complement'}/>)}
      {asset.id==='mind-map'&&<Interactive kind="mind-map" preset="study-session" id="library-study-map"/>}
      {asset.id==='mind-map'&&<><p>A different graph supplied through the typed data API:</p><pre><code>{'<Interactive kind="mind-map" data={teachingMap} id="library-teaching-map" />'}</code></pre><Interactive kind="mind-map" data={teachingMap} id="library-teaching-map"/></>}
      {asset.id==='relation-map'&&<RelationMap/>}
      {asset.id==='learning-cycle'&&<ProcessDiagram preset="cycle" id="library-learning-cycle"/>}
      {asset.id==='learning-mapping'&&<LearningFigure kind="mapping"/>}
      {asset.id==='learning-methods'&&<LearningFigure kind="methods"/>}
      {asset.id==='learning-practice'&&<LearningFigure kind="interleaving"/>}
      {asset.id==='learning-spacing'&&<LearningFigure kind="spacing"/>}
      {asset.id==='learning-bloom'&&<QuestionLens/>}
      {asset.id==='learning-template'&&<StudyTemplate kind="session"/>}
      {asset.id==='logic'&&<Interactive kind="logic" preset="implication" id="library-logic"/>}
      {asset.id==='nand'&&<Interactive kind="logic" preset="nand" id="library-nand"/>}
      {asset.id==='number-domains'&&<NumberDomains/>}
      {asset.id==='expression-trees'&&<ExpressionTrees variant="distributivity"/>}
      {asset.id==='comparison'&&<MatrixComparison cases={[{matrix:[[1,0],[0,1]],label:'Unit area',detail:'det = 1'},{matrix:[[1,0],[0,2]],label:'Double area',detail:'det = 2'},{matrix:[[1,0],[0,0]],label:'Collapsed area',detail:'det = 0'}]} caption="The dashed square is the input; colored columns and the filled image share one matrix."/>}
      {asset.id==='area'&&<Interactive kind="vectors" preset="area-and-orientation" id="library-area"/>}
      {asset.id==='combination'&&<Interactive kind="vectors" preset="linear-combination" id="library-combination"/>}
      {asset.id==='coordinate-basis'&&<Interactive kind="vectors" preset="coordinate-basis" id="library-coordinate-basis"/>}
      {asset.id==='rank'&&<Interactive kind="vectors" preset="rank-collapse" id="library-rank"/>}
      {asset.id==='matrix'&&<Interactive kind="matrix-product" left={[[1,2,3],[0,-1,2]]} right={[[1,0],[2,1],[0,3]]}/>}
      {asset.id==='rotation'&&<Interactive kind="rotation"/>}
      {asset.id==='shear'&&<Interactive kind="shear"/>}
      {asset.id==='figure'&&<VectorFigure description="Two displacements placed head to tail" caption="The second displacement starts at the first tip." vectors={[{to:[2,1],label:'u'},{from:[2,1],to:[3,3],label:'v',role:'blue'}]}/>}
    </section>)}
  </div>
</SiteLayout>
