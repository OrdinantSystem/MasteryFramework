---
import { getLessons, lessonUrl, localeUrl, courseUrl, url } from '../lib/content';
import { locales, strings, languageNames, type Locale } from '../lib/i18n';
import {chaptersFor,chapterFor,courses,courseFor,type CourseId} from '../lib/navigation';
import '../styles/site.css';
import 'katex/dist/katex.min.css';
interface Props { title: string; description: string; locale?: Locale; current?: string; courseId?:CourseId; headings?: {depth:number;slug:string;text:string}[]; }
const { title,description,locale='en',current='index',headings=[],courseId }=Astro.props;
Astro.locals.locale=locale;
const t=strings(locale);
const lessons=await getLessons(locale);
const activeCourse=courseId?courseFor(courseId):undefined;
const currentLesson=lessons.find(l=>l.key===current&&l.data.course===courseId);
const currentChapter=currentLesson?chapterFor(currentLesson.data.chapter):undefined;
const equivalent=(lang:Locale)=>current==='index'?localeUrl(lang):current==='search'?localeUrl(lang,'search/'):current==='404'||current==='library'?localeUrl(lang):current==='course'&&courseId?courseUrl(courseId,lang):lessonUrl(current,lang,courseId);
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="color-scheme" content="light dark"/>
  <slot name="head"/>
  <title>{title} · myNotes</title><link rel="icon" type="image/svg+xml" href={url('favicon.svg')}/>
  {locales.map(lang=><link rel="alternate" hreflang={lang} href={new URL(equivalent(lang),Astro.site)} />)}
  <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('mynotes-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script>
</head>
<body>
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="topbar" data-pagefind-ignore>
    <a class="brand" href={localeUrl(locale)} aria-label="myNotes"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h7c2 0 3 1 3 3v12c0-2-1-3-3-3H4V5Zm16 0h-3v12h3V5Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></span>my<span>Notes</span><small>{t.studyNotes}</small></a>
    <div class="header-actions">
      <a class="search-link" aria-label={t.search} href={localeUrl(locale,'search/')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><span>{t.search}</span></a>
      <details class="language-menu"><summary aria-label={`${t.language}: ${languageNames[locale]}`}><span>{languageNames[locale]}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></summary><nav aria-label={t.language}>{locales.map(lang=><a href={equivalent(lang)} lang={lang} hreflang={lang} aria-current={locale===lang?'page':undefined}>{languageNames[lang]}</a>)}</nav></details>
      <button class="theme-button" type="button" aria-label={t.theme} title={t.theme}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="sidebar">{t.contents} ☰</button>
    </div>
  </header>
  <div class="app-layout">
    <aside id="sidebar" class="sidebar" data-pagefind-ignore>
      <a class:list={['archive-link',{active:current==='index'}]} href={localeUrl(locale)}><span aria-hidden="true">▦</span>{t.overview}</a>
      <nav class="content-tree" aria-label={t.lessons}>
        <details open class="tree-subject" data-tree="mathematics"><summary><span class="tree-chevron" aria-hidden="true">›</span><span class="subject-icon" aria-hidden="true">∑</span>{t.mathematics}</summary>
          {courses.map(course=><details open={course.id===courseId} class="tree-course" data-tree={course.id}><summary><span class="tree-chevron" aria-hidden="true">›</span>{course.title[locale]}</summary><a class="course-overview-link" href={courseUrl(course.id,locale)} aria-label={`${t.overview} — ${course.title[locale]}`}>{t.overview} ↗</a>
            {chaptersFor(course.id).map(chapter=><details open={chapter.id===(currentChapter?.id??chaptersFor(course.id)[0].id)} class="tree-chapter-branch" data-tree={chapter.id}><summary><span class="tree-chevron" aria-hidden="true">›</span>{chapter.title[locale]}</summary>{chapter.groups.map(group=><details open class="tree-group" data-tree={`${chapter.id}-${group.key}`}><summary><span class="tree-chevron" aria-hidden="true">›</span>{group.title[locale]}<small>{group.orders.length}</small></summary>{lessons.filter(l=>l.data.course===course.id&&l.data.chapter===chapter.id&&group.orders.includes(l.data.order)).map(l=><a class:list={['lesson-link',{active:current===l.key&&course.id===courseId}]} href={lessonUrl(l.key,locale,course.id)} aria-current={current===l.key&&course.id===courseId?'page':undefined}><span class="lesson-number">{String(l.data.order).padStart(2,'0')}</span><span>{l.data.navTitle}</span>{current===l.key&&course.id===courseId&&<span class="active-dot" aria-hidden="true"/>}</a>)}</details>)}</details>)}
          </details>)}
        </details>
      </nav>
      <div class="sidebar-bottom"><span>{t.archive}</span></div>
    </aside>
    <main id="main" class="main-area">
      <div class="breadcrumbs" data-pagefind-ignore><a href={localeUrl(locale)}>{t.notes}</a>{activeCourse&&<><span>/</span><a href={courseUrl(activeCourse.id,locale)}>{activeCourse.title[locale]}</a></>}{currentChapter&&<><span>/</span><a href={`${courseUrl(courseId!,locale)}#${currentChapter.id}`}>{currentChapter.title[locale]}</a></>}{current!=='index'&&current!=='course'&&<><span>/</span><span>{title}</span></>}</div>
      <div class="reading-layout"><div class="reading-column"><slot /></div></div>
      {headings.length>2&&<aside class="page-toc" data-pagefind-ignore><details open><summary>{t.onPage}<span aria-hidden="true">⌄</span></summary><nav aria-label={t.onPage}>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></details></aside>}
      <footer class="site-footer" data-pagefind-ignore><span>myNotes <span aria-hidden="true">/</span>{activeCourse?.title[locale]??t.archive}</span><button class="print-button" type="button">{t.print} ↗</button></footer>
    </main>
  </div>
  <noscript><nav class="language-fallback" aria-label={t.language}>{locales.map(lang=><a href={equivalent(lang)} lang={lang}>{languageNames[lang]}</a>)}</nav></noscript>
  <script>
    document.documentElement.classList.add('js');
    const languageMenu=document.querySelector<HTMLDetailsElement>('.language-menu');
    languageMenu?.querySelectorAll<HTMLAnchorElement>('a').forEach(link=>link.addEventListener('click',()=>{if(location.pathname.includes('/search'))link.search=location.search}));
    document.addEventListener('pointerdown',event=>{if(languageMenu&&!languageMenu.contains(event.target as Node))languageMenu.open=false});
    languageMenu?.addEventListener('focusout',()=>requestAnimationFrame(()=>{if(!languageMenu.contains(document.activeElement))languageMenu.open=false}));
    document.querySelector('.theme-button')?.addEventListener('click',()=>{const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=theme;try{localStorage.setItem('mynotes-theme',theme)}catch{}});
    const menu=document.querySelector<HTMLButtonElement>('.menu-button');
    const closeMenu=()=>{menu?.setAttribute('aria-expanded','false');document.getElementById('sidebar')?.classList.remove('is-open')};
    menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.getElementById('sidebar')?.classList.toggle('is-open',open)});
    document.querySelector('.print-button')?.addEventListener('click',()=>window.print());
    document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes((e.target as HTMLElement).tagName)){e.preventDefault();document.querySelector<HTMLAnchorElement>('.search-link')?.click()}if(e.key==='Escape'){closeMenu();if(languageMenu?.open){languageMenu.open=false;languageMenu.querySelector('summary')?.focus()}}});
    document.querySelectorAll<HTMLDetailsElement>('[data-tree]').forEach(details=>{
      try{const value=localStorage.getItem('mynotes-tree-'+details.dataset.tree);if(value!==null)details.open=value==='open'}catch{}
      // Always reveal the active lesson, even if a previous visit collapsed its branch.
      if(details.querySelector('[aria-current="page"]'))details.open=true;
      details.addEventListener('toggle',()=>{try{localStorage.setItem('mynotes-tree-'+details.dataset.tree,details.open?'open':'closed')}catch{}});
    });
    const active=document.querySelector<HTMLElement>('#sidebar a[aria-current="page"]'),sidebar=document.getElementById('sidebar');
    if(active&&sidebar&&matchMedia('(min-width:801px)').matches){const a=active.getBoundingClientRect(),b=sidebar.getBoundingClientRect();if(a.bottom>b.bottom)sidebar.scrollTop+=a.bottom-b.bottom+16;else if(a.top<b.top)sidebar.scrollTop-=b.top-a.top+16;}
  </script>
</body>
</html>
