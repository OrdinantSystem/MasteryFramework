---
import InterleavingPractice from './InterleavingPractice.astro';
import {text} from '../lib/learning/diagrams';
interface Props {kind:'methods'|'mapping'|'interleaving'|'spacing'|'problem-first'|'hints'|'evidence'|'handoff'}
const {kind}=Astro.props,l=Astro.locals.locale||'en';
const t=(en:string,de:string)=>text(en,de)[l];
const methods=[
 [t('Mind mapping','Begriffsnetz'),t('How does it fit together?','Wie hängt es zusammen?'),t('Organize relationships','Beziehungen ordnen'),'accent'],
 [t('Feynman explanation','Feynman-Erklärung'),t('Can I explain why?','Kann ich das Warum erklären?'),t('Reconstruct understanding','Verständnis rekonstruieren'),'blue'],
 [t('Interleaved practice','Verschachteltes Üben'),t('Which method fits here?','Welche Methode passt hier?'),t('Discriminate and transfer','Unterscheiden und übertragen'),'purple'],
 [t('Spaced retrieval','Verteiltes Abrufen'),t('Can I use it later?','Kann ich es später nutzen?'),t('Maintain accessible knowledge','Wissen verfügbar halten'),'coral']
];
const hints=[t('Independent attempt','Selbstständiger Versuch'),t('Strategic question','Strategische Frage'),t('Relevant concept','Passender Begriff'),t('One local step','Ein einzelner Schritt'),t('Analogous example','Analoges Beispiel'),t('Full solution','Vollständige Lösung')];
const dimensions=[t('Definitions','Definitionen'),t('Intuition','Intuition'),t('Justification','Begründung'),t('Boundaries','Geltungsgrenzen'),t('Transfer','Transfer'),t('Delayed recall','Späterer Abruf')];
---
<figure class:list={['learning-figure',`learning-${kind}`]}>
 {kind==='methods'&&<><div class="method-grid">{methods.map(([name,question,purpose,role],i)=><div class={`method-card ${role}`}><span class="figure-step">0{i+1}</span><h3>{name}</h3><p>{question}</p><small>{purpose}</small></div>)}</div><figcaption>{t('Four complementary jobs. Choose the method for the gap you are trying to close.','Vier ergänzende Aufgaben. Wähle die Methode passend zur konkreten Lücke.')}</figcaption></>}
 {kind==='mapping'&&<><div class="mapping-pair"><section><h3>{t('Related words','Verwandte Wörter')}</h3><div class="word-cloud">{[t('Study session','Lernsitzung'),t('Mapping','Begriffsnetz'),t('Retrieval','Abrufen'),t('Feedback','Rückmeldung'),t('Review','Wiederholen')].map(label=><span>{label}</span>)}</div><p>{t('Which relationship does each connection claim?','Welche Beziehung behauptet jede Verbindung?')}</p></section><section><h3>{t('A relationship you can explain','Eine erklärbare Beziehung')}</h3><div class="map-node">{t('Unaided explanation','Erklärung ohne Hilfe')}</div><div class="map-edge">↓ {t('provides an attempt for','liefert einen Versuch für')}</div><div class="map-node blue">{t('Feedback','Rückmeldung')}</div><div class="map-edge">↓ {t('can identify','kann aufzeigen')}</div><svg class="map-fork" viewBox="0 0 400 30" aria-hidden="true"><path d="M200 0V8L100 28M200 8 300 28" fill="none" stroke="var(--accent)" stroke-width="2"/></svg><div class="map-branches"><div class="map-node">{t('Missing ideas','Fehlende Ideen')}</div><div class="map-node">{t('Incorrect relationships','Falsche Beziehungen')}</div></div></section></div><figcaption>{t('Illustrative study example: compare an unaided attempt with a reliable source to identify what needs correction.','Beispiel zum Lernen: Vergleiche einen Versuch ohne Hilfe mit einer verlässlichen Quelle, um Korrekturbedarf zu erkennen.')}</figcaption></>}
 {kind==='interleaving'&&<InterleavingPractice />}
 {kind==='spacing'&&<><div class="figure-label">{t('Illustrative review schedule','Beispielhafter Wiederholungsplan')}</div><ol class="review-timeline">{[0,1,3,7,21].map((day,i)=><li><strong>{t('Day','Tag')} {day}</strong><span class="timeline-dot" aria-hidden="true"/><span>{i===0?t('Learn','Lernen'):t('Retrieve','Abrufen')}</span></li>)}</ol><figcaption>{t('Days are labels; spacing on this diagram is not to scale. These intervals are examples, not an optimal universal schedule. Adapt after success, difficulty, and deadlines.','Die Tageszahlen sind Beschriftungen; die Abstände sind nicht maßstabsgetreu. Die Intervalle sind Beispiele, kein universell optimaler Plan. An Erfolg, Schwierigkeiten und Termine anpassen.')}</figcaption></>}
 {kind==='problem-first'&&<><div class="progression-pair">{[[t('Knowledge-first route','Wissensorientierter Weg'),[t('Memorize facts','Fakten einprägen'),t('Understand concepts','Begriffe verstehen'),t('Apply later','Später anwenden')]], [t('Goal-framed route','Zielorientierter Weg'),[t('Preview a meaningful problem','Eine sinnvolle Aufgabe ansehen'),t('Identify missing foundations','Fehlende Grundlagen erkennen'),t('Learn, apply, and revisit','Lernen, anwenden und erneut prüfen')]]].map(([title,steps])=><section><h3>{title}</h3><ol>{(steps as string[]).map(step=><li>{step}</li>)}</ol></section>)}</div><figcaption>{t('The early problem supplies a purpose. It does not remove the need for instruction or worked examples.','Die frühe Aufgabe schafft einen Zweck. Erklärungen und ausgearbeitete Beispiele bleiben nötig.')}</figcaption></>}
 {kind==='hints'&&<><ol class="hint-ladder">{hints.map((label,i)=><li><strong>H{i}</strong><span>{label}</span></li>)}</ol><figcaption>{t('Record the highest hint used. Ask for the smallest next hint; a guided solution is evidence of assisted work.','Den höchsten genutzten Hinweis notieren. Den kleinsten nächsten Hinweis anfordern; eine geführte Lösung zeigt unterstützte Arbeit.')}</figcaption></>}
 {kind==='evidence'&&<><div class="evidence-grid">{dimensions.map((v,i)=><div><span class="figure-step">0{i+1}</span><strong>{v}</strong><small>{t('A task + an observed result','Eine Aufgabe + ein beobachtetes Ergebnis')}</small></div>)}</div><figcaption>{t('Keep a profile, not one mastery percentage. Not assessed means NA; immediate success is provisional.','Ein Profil führen, keinen einzigen Beherrschungsprozentsatz. Nicht geprüft heißt NA; unmittelbarer Erfolg ist vorläufig.')}</figcaption></>}
 {kind==='handoff'&&<><div class="handoff-strip">{[t('Sources + goal','Quellen + Ziel'),t('Exact attempts + hints','Genaue Versuche + Hinweise'),t('Gaps + next task','Lücken + nächste Aufgabe'),t('Delayed review','Spätere Wiederholung')].map(v=><span>{v}</span>)}</div><figcaption>{t('Carry the evidence into the next session. A new agent only knows the context you actually give it.','Die Nachweise in die nächste Sitzung mitnehmen. Ein neuer Agent kennt nur den tatsächlich mitgegebenen Kontext.')}</figcaption></>}
</figure>
