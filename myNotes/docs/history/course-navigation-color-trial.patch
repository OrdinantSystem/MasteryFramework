--- a/myNotes/my_notes_web/src/styles/site.css
+++ b/myNotes/my_notes_web/src/styles/site.css
@@ -1954,3 +1954,52 @@
 .logic-lab td[data-truth-value="1"] {
   color: var(--accent);
 }
+
+/* A stable course color connects each heading with its nested branches. */
+.tree-course {
+  --course-color: var(--accent);
+  --course-tint: var(--tint);
+}
+.tree-course[data-course="linear-algebra"] {
+  --course-color: var(--blue);
+  --course-tint: var(--blue-tint);
+}
+.tree-course[data-course="learning"] {
+  --course-color: var(--purple);
+  --course-tint: var(--purple-tint);
+}
+.content-tree .tree-course {
+  margin-block: var(--space-3);
+  border-left: 1px solid var(--course-color);
+}
+.tree-course > summary {
+  min-height: 44px;
+  font-size: 13px;
+  font-weight: 650;
+  color: var(--course-color);
+  background: var(--bg);
+}
+@media (min-width: 801px) {
+  .tree-course[open] > summary {
+    position: sticky;
+    /* Match the sidebar's 28 px top padding so rows cannot peek above it. */
+    top: -28px;
+    z-index: 2;
+    border-bottom: 1px solid var(--line);
+  }
+}
+.tree-course > summary:hover {
+  background: var(--surface);
+}
+.tree-course .tree-chapter-branch > summary,
+.tree-course .tree-group > summary,
+.tree-course .course-overview-link {
+  color: var(--course-color);
+}
+.tree-course .lesson-link.active {
+  color: var(--course-color);
+  background: var(--course-tint);
+}
+.tree-course .active-dot {
+  background: var(--course-color);
+}
